{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tandem",
  "version": "1.0.0",
  "identifier": "com.vdouay.tandem",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tandem",
        "width": 1040,
        "height": 720,
        "minWidth": 820,
        "minHeight": 560,
        "decorations": false,
        "resizable": true,
        "visible": false,
        "center": true
      },
      {
        "label": "tray",
        "url": "index.html?window=tray",
        "title": "Tandem",
        "width": 320,
        "height": 340,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "V. Douay",
    "shortDescription": "Play your PC's audio on several outputs at once, in sync",
    "longDescription": "Tandem mirrors what Windows plays on one device to any number of other outputs, delaying each one so everything comes out in sync, with automatic clock-drift correction and optional microphone auto-sync.",
    "copyright": "© 2026 V. Douay · AGPL-3.0-or-later",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English",
          "French"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    },
    "license": "AGPL-3.0-or-later",
    "licenseFile": "../LICENSE",
    "resources": {
      "../LICENSE": "LICENSE.txt",
      "../NOTICE": "NOTICE.txt",
      "../THIRD_PARTY_LICENSES.md": "THIRD_PARTY_LICENSES.md"
    },
    "homepage": "https://github.com/Goose254/tandem"
  }
}
